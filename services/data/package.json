{
  "name": "devsecops-data",
  "version": "0.1.0",
  "private": true,
  "description": "Data microservice: проєкти та задачі (SQLite) з валідацією",
  "main": "dist/index.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
